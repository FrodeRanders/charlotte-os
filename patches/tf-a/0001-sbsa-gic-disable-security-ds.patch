index 962dbb3..a718a8c 100644
--- a/plat/qemu/qemu_sbsa/sbsa_gic.c
+++ b/plat/qemu/qemu_sbsa/sbsa_gic.c
@@ -5,6 +5,7 @@
  */
 
 #include <drivers/arm/gicv3.h>
+#include <lib/mmio.h>
 #include <plat/common/platform.h>
 
 static const interrupt_prop_t qemu_interrupt_props[] = {
@@ -52,6 +53,18 @@ void plat_qemu_gic_init(void)
 	gicv3_distif_init();
 	gicv3_rdistif_init(plat_my_core_pos());
 	gicv3_cpuif_enable(plat_my_core_pos());
+
+	/*
+	 * CharlotteOS: the whole boot chain runs at Non-secure EL1 (QEMU TCG
+	 * EL2 is unreliable), so no secure world is ever active. Leave the GIC
+	 * with security disabled (DS=1) so the Non-secure EL1 kernel can
+	 * configure its SPIs as Group 1 via GICD_IGROUPR (QEMU drops those
+	 * writes for NS+DS=0) and so QEMU reports LPIs as Group 1 (with DS=0
+	 * QEMU tags them Group 0, signals FIQ, and the kernel never acks them,
+	 * leaving them pending and masking every other interrupt on that CPU).
+	 */
+	mmio_write_32(sbsa_get_gicd() + GICD_CTLR,
+		      mmio_read_32(sbsa_get_gicd() + GICD_CTLR) | CTLR_DS_BIT);
 }
 
 void qemu_pwr_gic_on_finish(void)
