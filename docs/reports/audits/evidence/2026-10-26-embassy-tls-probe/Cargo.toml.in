[package]
name="charlotte-embassy-migration-probe"
version="0.0.0"
edition="2024"
[workspace]
[dependencies]
embedded-tls={git="https://github.com/embassy-rs/embedded-tls",rev="6487c62bb084c33361822022e21836ddfd48388f",default-features=false,features=["rustpki","p256","p384","ed25519"]}
embassy-crypto={git="https://github.com/embassy-rs/embassy",rev="822a76ea91f2c0885c6eb0c65fe91181e31133e1"}
embassy-crypto-rustcrypto={git="https://github.com/embassy-rs/embassy",rev="822a76ea91f2c0885c6eb0c65fe91181e31133e1",default-features=false,features=["embassy-crypto-sha256","embassy-crypto-sha384","embassy-crypto-sha512","embassy-crypto-hmac-sha256","embassy-crypto-hmac-sha384","embassy-crypto-p256-ecdh","embassy-crypto-p256-ecdsa","embassy-crypto-p384-ecdsa","embassy-crypto-ed25519"]}

# Preserve the currently-qualified record-cipher owners behind the Embassy API.
aes = {version="=0.8.4",default-features=false,features=["zeroize"]}
aes-gcm = {version="=0.10.3",default-features=false,features=["aes","zeroize"]}
ghash = {version="=0.5.1",default-features=false,features=["zeroize"]}
polyval = {version="=0.6.2",default-features=false,features=["zeroize"]}
zeroize={version="=1.9.0",default-features=false}
p256={version="=0.14.0",default-features=false,features=["pkcs8"]}
[dev-dependencies]
embassy-crypto-rand={git="https://github.com/embassy-rs/embassy",rev="822a76ea91f2c0885c6eb0c65fe91181e31133e1"}
