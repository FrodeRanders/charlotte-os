  "finding": {
    "gap": "Pinned x86 POLYVAL dispatcher has no Drop delegation for its ManuallyDrop union, leaving its original active authentication state unerased on ordinary dispatcher Drop. Source-confirmed, without a cross-domain retained-memory read.",
    "correction": "Freestanding x86 target selects polyval_force_soft; production GHash/Polyval destructor-presence guard covers that target as well as AArch64. Explicit unsafe flag/erasure-feature overrides reject.",
    "semantics": "Pinned enabled software Drop clears named h/s fields. needs_drop establishes destructor presence; no post-Drop target-memory measurement or complete TLS-state erasure proof.",
    "tradeoff": "PCLMUL authentication acceleration disabled on freestanding x86; AES selection and TLS cipher unchanged. Throughput impact unmeasured.",
    "new_production_buffer_capability_root_registry_custody_or_physical_replay_owner": false
  },
