    "injected_control_source": "\n#[cfg(test)]\nmod lifetime_regression {\n    use super::*;\n    const FIRST: &[u8] = b\"r=client-server,s=c2FsdA==,i=4096\";\n    #[test]\n    fn proof_generation_releases_password_owner() {\n        let mut client = Client::new(\"user\", b\"public-fixture-password\", \"client\").unwrap();\n        client.receive_server_first(FIRST).unwrap();\n        assert!(client.password.is_empty(), \"password retained after proof generation\");\n    }\n    #[test]\n    fn rejected_final_retires_verifier() {\n        let mut client = Client::new(\"user\", b\"public-fixture-password\", \"client\").unwrap();\n        client.receive_server_first(FIRST).unwrap();\n        assert_eq!(client.receive_server_final(&vec![b'x'; MAX_SERVER_MESSAGE_BYTES + 1]), Err(Error::InvalidServerMessage));\n        assert!(client.expected_server_signature.is_none(), \"rejected final retained a reusable verifier\");\n    }\n}\n",
    "control_sha256": "6fc7b588268638ed6cd7b465920eab4577b3067f0a79d8913cd45f0c404595c6",
